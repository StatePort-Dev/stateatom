{
  "name": "stateatom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:extensions": "node scripts/build.mjs --extensions-only",
    "test": "node --test --test-isolation=none tests/*.test.mjs tests/engine/*.test.mjs tests/browser/*.test.mjs tests/vue/*.test.mjs",
    "dev": "node scripts/serve-phase2.mjs",
    "dev:react-host": "node scripts/serve-phase2.mjs --react-host-props",
    "verify:ide": "node tests/integration/ide.mjs",
    "verify:browser": "node tests/integration/browser.mjs",
    "sanitize:artifacts": "node scripts/sanitize-artifacts.mjs",
    "prepare:short-loop": "node scripts/prepare-short-loop.mjs",
    "verify:short-loop": "node tests/integration/short-loop.mjs",
    "verify:react-commit": "node experiments/react-commit/run.mjs",
    "prepare:independent": "node scripts/prepare-independent.mjs",
    "verify:independent": "node tests/integration/independent.mjs",
    "verify:react-host": "node tests/integration/react-host.mjs",
    "verify:react-host-ui": "node tests/integration/react.mjs",
    "verify:source-consumption": "node tests/integration/source-consumption.mjs",
    "verify:fetch-initiator": "node experiments/network/run.mjs",
    "verify:preview": "node tests/integration/react.mjs --acceptance",
    "verify:fetch-ui": "node tests/integration/react.mjs --acceptance --fetch-bindings",
    "dev:react-http": "node scripts/serve-phase2.mjs --react-host-props --fetch-initiators",
    "verify:fetch-product": "node experiments/network/product.mjs",
    "dev:react-state": "node scripts/serve-phase2.mjs --react-host-props --fetch-initiators --react-state-handoffs",
    "verify:react-state": "node tests/integration/react-state.mjs",
    "verify:react-state-ui": "node tests/integration/react.mjs --acceptance --fetch-bindings --state-handoffs",
    "dev:react-state-writes": "node scripts/serve-phase2.mjs --react-host-props --fetch-initiators --react-state-handoffs --source-writes",
    "verify:source-writes": "node tests/integration/react-state.mjs --source-writes",
    "verify:source-writes-ui": "node tests/integration/react.mjs --acceptance --fetch-bindings --state-handoffs --source-writes",
    "verify:compiled-inventory": "node experiments/execution/run.mjs",
    "verify:ownership-controls": "node experiments/execution/ownership.mjs",
    "verify:source-uses": "node experiments/execution/source.mjs",
    "verify:script-entry": "node experiments/execution/entry.mjs",
    "verify:query-handoffs": "node tests/integration/query-handoffs.mjs",
    "verify:query-calls": "node tests/integration/query-calls.mjs",
    "verify:write-access": "node tests/integration/write-access.mjs",
    "verify:write-access-ui": "node tests/integration/react.mjs --acceptance --fetch-bindings --state-handoffs --source-writes --write-access-guards",
    "dev:react-write-access": "node scripts/serve-phase2.mjs --react-host-props --fetch-initiators --react-state-handoffs --source-writes --write-access-guards",
    "verify:query-writes": "node tests/integration/query-writes.mjs",
    "verify:query-writes-ui": "node tests/integration/react.mjs --acceptance --fetch-bindings --state-handoffs --source-writes --write-access-guards --query-write-access-guards",
    "dev:react-query-writes": "node scripts/serve-phase2.mjs --react-host-props --fetch-initiators --react-state-handoffs --source-writes --write-access-guards --query-handoffs --query-call-census --query-write-access-guards",
    "verify:react-writes": "node tests/integration/react-writes.mjs",
    "verify:react-writes-ui": "node tests/integration/react.mjs --acceptance --fetch-bindings --state-handoffs --source-writes --write-access-guards --query-write-access-guards --react-write-access-guards",
    "dev:react-private-writes": "node scripts/serve-phase2.mjs --react-host-props --fetch-initiators --react-state-handoffs --source-writes --write-access-guards --query-handoffs --query-call-census --query-write-access-guards --react-write-access-guards",
    "verify:code-journal-ui": "node tests/integration/react.mjs --acceptance --fetch-bindings --state-handoffs --source-writes --write-access-guards --query-write-access-guards --react-write-access-guards --code-journal-checks",
    "verify:compiler-inputs": "node experiments/compiler/run.mjs",
    "verify:compiler-effects": "node experiments/compiler/run.mjs --effects",
    "verify:observer-identity": "node experiments/compiler/run.mjs --effects --observer-identity",
    "verify:observer-intrinsics": "node experiments/compiler/run.mjs --effects --observer-identity --telemetry-intrinsics",
    "verify:observer-closure": "node experiments/compiler/run.mjs --effects --observer-identity --telemetry-intrinsics --observer-closure",
    "verify:observer-entries": "node experiments/compiler/invocations.mjs",
    "verify:observer-effects": "node experiments/compiler/invocations.mjs --effects-frontier",
    "verify:observer-operands": "node experiments/compiler/invocations.mjs --operands",
    "verify:first-read-query": "node tests/integration/first-read-query.mjs",
    "verify:first-read-profile": "node tests/integration/first-read-profile.mjs",
    "verify:first-read-ui": "node tests/integration/first-read-ui.mjs",
    "dev:first-read": "node scripts/dev-first-read.mjs",
    "verify:first-read-session": "node tests/integration/first-read-session.mjs"
  },
  "dependencies": {
    "@angular/compiler": "20.3.34",
    "@angular/core": "20.3.34",
    "@angular/platform-browser": "20.3.34",
    "@babel/core": "7.29.7",
    "@babel/generator": "7.28.5",
    "@babel/parser": "7.28.5",
    "@babel/plugin-transform-react-jsx": "7.27.1",
    "@babel/traverse": "7.28.5",
    "@babel/types": "7.29.8",
    "@tanstack/query-core": "5.90.3",
    "@vitejs/plugin-vue": "6.0.1",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "4.0.0",
    "@vue/compiler-dom": "3.5.44",
    "@vue/compiler-sfc": "3.5.44",
    "esbuild": "0.25.12",
    "playwright": "1.63.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "svelte": "5.57.2",
    "vite": "7.3.7",
    "vue": "3.5.44",
    "zone.js": "0.15.1"
  },
  "description": "Experimental local UI inspection and evidence tooling",
  "license": "(MIT AND Apache-2.0)",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.17.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/StatePort-Dev/stateatom.git"
  }
