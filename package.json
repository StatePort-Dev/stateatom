{
  "name": "stateatom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:extensions": "node scripts/build.mjs --extensions-only",
    "test": "node --test --test-isolation=none tests/*.test.mjs stateatom-phase2/tests/*.test.mjs stateatom-oss-alpha/tests/*.test.mjs stateatom-diagnosis/tests/*.test.mjs",
    "dev": "node scripts/serve-phase2.mjs",
    "dev:react-host": "node scripts/serve-phase2.mjs --react-host-props",
    "verify:ide": "node stateatom-phase2/demo.mjs",
    "verify:browser": "node stateatom-oss-alpha/browser-check.mjs",
    "sanitize:artifacts": "node stateatom-phase2/sanitize.mjs",
    "prepare:short-loop": "node scripts/prepare-short-loop.mjs",
    "verify:short-loop": "node stateatom-short-loop/run.mjs",
    "verify:react-commit": "node stateatom-react-commit/run.mjs",
    "prepare:independent": "node scripts/prepare-independent.mjs",
    "verify:independent": "node stateatom-independent/run.mjs",
    "verify:react-host": "node stateatom-react-host/run.mjs",
    "verify:react-host-ui": "node stateatom-react-host/ui.mjs",
    "verify:source-consumption": "node stateatom-react-host/consumption.mjs",
    "verify:fetch-initiator": "node stateatom-network-probe/run.mjs",
    "verify:preview": "node stateatom-react-host/ui.mjs --acceptance",
    "verify:fetch-ui": "node stateatom-react-host/ui.mjs --acceptance --fetch-bindings",
    "dev:react-http": "node scripts/serve-phase2.mjs --react-host-props --fetch-initiators",
    "verify:fetch-product": "node stateatom-network-probe/product.mjs",
    "dev:react-state": "node scripts/serve-phase2.mjs --react-host-props --fetch-initiators --react-state-handoffs",
    "verify:react-state": "node stateatom-react-state/run.mjs",
    "verify:react-state-ui": "node stateatom-react-host/ui.mjs --acceptance --fetch-bindings --state-handoffs",
    "dev:react-state-writes": "node scripts/serve-phase2.mjs --react-host-props --fetch-initiators --react-state-handoffs --source-writes",
    "verify:source-writes": "node stateatom-react-state/run.mjs --source-writes",
    "verify:source-writes-ui": "node stateatom-react-host/ui.mjs --acceptance --fetch-bindings --state-handoffs --source-writes",
    "verify:compiled-inventory": "node stateatom-execution-probe/run.mjs",
    "verify:ownership-controls": "node stateatom-execution-probe/ownership.mjs",
    "verify:source-uses": "node stateatom-execution-probe/source.mjs",
    "verify:script-entry": "node stateatom-execution-probe/entry.mjs",
    "verify:query-handoffs": "node stateatom-query-handoff/run.mjs",
    "verify:query-calls": "node stateatom-query-handoff/calls.mjs",
    "verify:write-access": "node stateatom-write-access/run.mjs",
    "verify:write-access-ui": "node stateatom-react-host/ui.mjs --acceptance --fetch-bindings --state-handoffs --source-writes --write-access-guards",
    "dev:react-write-access": "node scripts/serve-phase2.mjs --react-host-props --fetch-initiators --react-state-handoffs --source-writes --write-access-guards",
    "verify:query-writes": "node stateatom-query-handoff/writes.mjs",
    "verify:query-writes-ui": "node stateatom-react-host/ui.mjs --acceptance --fetch-bindings --state-handoffs --source-writes --write-access-guards --query-write-access-guards",
    "dev:react-query-writes": "node scripts/serve-phase2.mjs --react-host-props --fetch-initiators --react-state-handoffs --source-writes --write-access-guards --query-handoffs --query-call-census --query-write-access-guards",
    "verify:react-writes": "node stateatom-react-state/writes.mjs",
    "verify:react-writes-ui": "node stateatom-react-host/ui.mjs --acceptance --fetch-bindings --state-handoffs --source-writes --write-access-guards --query-write-access-guards --react-write-access-guards",
    "dev:react-private-writes": "node scripts/serve-phase2.mjs --react-host-props --fetch-initiators --react-state-handoffs --source-writes --write-access-guards --query-handoffs --query-call-census --query-write-access-guards --react-write-access-guards",
    "verify:code-journal-ui": "node stateatom-react-host/ui.mjs --acceptance --fetch-bindings --state-handoffs --source-writes --write-access-guards --query-write-access-guards --react-write-access-guards --code-journal-checks",
    "verify:compiler-inputs": "node stateatom-compiler-probe/run.mjs",
    "verify:compiler-effects": "node stateatom-compiler-probe/run.mjs --effects",
    "verify:observer-identity": "node stateatom-compiler-probe/run.mjs --effects --observer-identity",
    "verify:observer-intrinsics": "node stateatom-compiler-probe/run.mjs --effects --observer-identity --telemetry-intrinsics",
    "verify:observer-closure": "node stateatom-compiler-probe/run.mjs --effects --observer-identity --telemetry-intrinsics --observer-closure",
    "verify:observer-entries": "node stateatom-compiler-probe/invocations.mjs",
    "verify:observer-effects": "node stateatom-compiler-probe/invocations.mjs --effects-frontier",
    "verify:observer-operands": "node stateatom-compiler-probe/invocations.mjs --operands",
    "verify:first-read-query": "node stateatom-field-revision/run.mjs",
    "verify:first-read-profile": "node stateatom-field-revision/run-profile.mjs",
    "verify:first-read-ui": "node stateatom-field-revision/ui.mjs",
    "dev:first-read": "node stateatom-field-revision/serve.mjs",
    "verify:first-read-session": "node stateatom-field-revision/session.mjs"
  },
  "dependencies": {
    "@angular/compiler": "20.3.34",
    "@angular/core": "20.3.34",
    "@angular/platform-browser": "20.3.34",
    "@babel/core": "7.29.7",
    "@babel/generator": "7.28.5",
    "@babel/parser": "7.28.5",
    "@babel/plugin-transform-react-jsx": "7.27.1",
    "@babel/traverse": "7.28.5",
    "@babel/types": "7.29.8",
    "@tanstack/query-core": "5.90.3",
    "@vitejs/plugin-vue": "6.0.1",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "4.0.0",
    "@vue/compiler-dom": "3.5.44",
    "@vue/compiler-sfc": "3.5.44",
    "esbuild": "0.25.12",
    "playwright": "1.63.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "svelte": "5.57.2",
    "vite": "7.3.7",
    "vue": "3.5.44",
    "zone.js": "0.15.1"
  },
  "description": "Experimental local UI inspection and evidence tooling",
  "license": "(MIT AND Apache-2.0)",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.17.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/StatePort-Dev/stateatom.git"
  }
}
