{
  "name": "stateatom-dev-helper",
  "displayName": "StateAtom Development Helper",
  "version": "0.1.3",
  "publisher": "local-research",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Pairing requires workspace trust."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "xray.pair",
        "title": "X-Ray: Show local pairing token"
      },
      {
        "command": "stateatom.copyConnectionReceipt",
        "title": "StateAtom: Copy connection receipt"
      },
      {
        "command": "stateatom.disconnect",
        "title": "StateAtom: Disconnect source helper"
      }
    ],
    "configuration": {
      "title": "StateAtom source connection",
      "properties": {
        "stateatom.helperPort": {
          "type": "number",
          "default": 47731,
          "minimum": 1,
          "maximum": 65535,
          "scope": "resource",
          "description": "Explicit 127.0.0.1 helper port. Change if occupied; no scanning."
        },
        "stateatom.appOrigin": {
          "type": "string",
          "default": "http://localhost:5173",
          "scope": "resource",
          "description": "Canonical exact HTTP development origin for the private connection receipt."
        },
        "stateatom.sourceFolder": {
          "type": "string",
          "default": ".",
          "scope": "resource",
          "description": "Source folder relative to the selected trusted workspace. Dot explicitly selects the whole workspace."
        }
      }
    }
  },
  "license": "(MIT AND Apache-2.0)",
  "description": "Open local source bridge for the StateAtom experimental inspector",
  "repository": {
    "type": "git",
    "url": "https://github.com/StatePort-Dev/stateatom.git"
  }
}
