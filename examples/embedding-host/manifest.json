{
  "manifest_version": 3,
  "name": "StateAtom MV3 embedding example",
  "version": "0.1.0",
  "description": "Local research inspector; loopback read-only with explicit development actions",
  "permissions": [
    "debugger",
    "scripting",
    "storage",
    "tabs",
    "offscreen"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://[::1]/*"
  ],
  "background": {
    "service_worker": "host-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open StateAtom"
  }
}
