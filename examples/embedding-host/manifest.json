{
  "manifest_version": 3,
  "name": "StateAtom MV3 embedding example",
  "version": "0.1.0",
  "description": "Local inspector with explicit development actions and opt-in read-only HTTPS",
  "permissions": [
    "debugger",
    "scripting",
    "storage",
    "tabs",
    "offscreen"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://[::1]/*"
  ],
  "background": {
    "service_worker": "host-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open StateAtom"
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}
