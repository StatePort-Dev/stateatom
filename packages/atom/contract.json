{
  "apiVersion": 1,
  "wireVersion": 1,
  "uiContract": "2.1.0",
  "uiPackage": "0.2.0-candidate.20261018.2",
  "storageNamespace": "stateport.atom.v1.",
  "capabilities": [
    "read",
    "inject",
    "reload",
    "cache",
    "override",
    "replay"
  ],
  "origins": [
    "http://localhost:<port>",
    "http://127.0.0.1:<port>",
    "http://[::1]:<port>"
  ],
  "capabilityVersion": 1,
  "features": [
    "capability-policy-v1",
    "native-picker-v1",
    "live-debugger-guardian-v1"
  ],
  "featureDiscovery": {
    "operation": "capabilities",
    "requiredVersion": 1,
    "notEvidence": "Admission and observation availability are separate from source/execution claims"
  },
  "sitePolicy": {
    "scope": "exact scheme, host and port",
    "default": "read-only",
    "development": "explicit session connection with individual actions",
    "production": "read-only by default; separate two-stage production input permission",
    "helper": "canonical http://127.0.0.1:<port>, separate browser access",
    "artifacts": "separate exact-origin browser permission"
  },
  "guardian": {
    "protocolVersion": 1,
    "authority": "live-memory-only",
    "offscreenReason": "WORKERS",
    "assets": [
      "guardian.html",
      "guardian.js",
      "guardian-worker.js"
    ],
    "scope": "Resource admission and cleanup; not input or execution evidence"
  }
}
